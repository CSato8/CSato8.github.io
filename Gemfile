source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "webrick", "~> 1.8"
gem "html-proofer", "~> 5.0"
gem "jekyll-gist", "~> 1.5"
gem "rouge", "~> 4.0"

# Windows and JRuby does not include zoneinfo files, so bundle the tzinfo-data gem and associated library.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", "~> 1.2"
  gem "tzinfo-data"
end

gem "webrick", "~> 1.7"
gem 'html-proofer'
gem 'jekyll-gist'
gem 'rouge'
